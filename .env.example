APP_NAME=fretiq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# NOTE: tracking pixel needs a public host; localhost = opens never register (see CLAUDE.md).
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fretiq
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="prospection@fretiq.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Zoho integration (driver=local in dev; switch to zoho in prod)
# ---------------------------------------------------------------------------
ZOHO_CRM_DRIVER=local
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_API_URL=https://www.zohoapis.com/crm/v2
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DEFAULT_FROM_EMAIL=

ZOHO_CAMPAIGNS_DRIVER=local
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Discovery APIs
# ---------------------------------------------------------------------------
SERPAPI_API_KEY=
HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# Prospecting gate — keep false in dev/staging; true only on prod after review
# ---------------------------------------------------------------------------
PROSPECTING_COLD_SEND_ENABLED=false
DISCOVERY_DRIVER=local
