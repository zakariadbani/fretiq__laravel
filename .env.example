APP_NAME=fretiq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# NOTE: tracking pixel needs a public host; localhost = opens never register (see CLAUDE.md).
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fretiq
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="prospection@fretiq.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Zoho integration (driver=local in dev; switch to zoho in prod)
# ---------------------------------------------------------------------------
ZOHO_CRM_DRIVER=local
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_API_URL=https://www.zohoapis.com/crm/v2
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Zoho CRM V2 mirror — infrastructure and transport tuning
# ---------------------------------------------------------------------------
ZOHO_V2_QUEUE=zoho
ZOHO_V2_QUEUE_CONNECTION=zoho
ZOHO_V2_QUEUE_RETRY_AFTER=1260
ZOHO_V2_REPORTING_TIMEZONE=Europe/Paris
ZOHO_V2_OVERLAP_MINUTES=15
ZOHO_V2_LEASE_SECONDS=14400
ZOHO_V2_MODULE_DELIVERY_TIMEOUT_SECONDS=1200
ZOHO_V2_MODULE_LEASE_SECONDS=1500
ZOHO_V2_MODULE_CONTINUATION_DELAY_SECONDS=5
ZOHO_V2_MODULE_CAPACITY_DEFERRAL_SECONDS=60
ZOHO_V2_MODULE_LEASE_CONFLICT_MAX_DELAY_SECONDS=3600
ZOHO_V2_MODULE_RECOVERY_STALE_SECONDS=60
ZOHO_V2_MODULE_RETRYING_RECOVERY_STALE_SECONDS=1860
ZOHO_V2_QUOTE_RECONCILIATION_CHUNK_SIZE=500
ZOHO_V2_BULK_POLL_DELAY_SECONDS=30
ZOHO_V2_BULK_LOCK_RETRY_SECONDS=30
ZOHO_V2_BULK_FAILURE_RETRY_SECONDS=300
ZOHO_V2_BULK_WORK_BATCH_SIZE=100
ZOHO_V2_BULK_STAGING_BATCH_SIZE=1000
ZOHO_V2_BULK_DELIVERY_TIMEOUT_SECONDS=900
ZOHO_V2_BULK_LEASE_SECONDS=1500
ZOHO_V2_BULK_MAX_INLINE_RETRY_AFTER_SECONDS=30
ZOHO_V2_BULK_CAPACITY_DEFERRAL_SECONDS=60
ZOHO_V2_BULK_RUN_HORIZON_HOURS=72
ZOHO_V2_BULK_TERMINATION_CHUNK_SIZE=500
ZOHO_V2_BULK_MAX_RETRY_AFTER_SECONDS=3600
ZOHO_V2_BULK_DOWNLOADS_PER_MINUTE=10
ZOHO_V2_BULK_VERIFIED_MODULES=
ZOHO_V2_BULK_MAX_ARCHIVE_BYTES=67108864
ZOHO_V2_BULK_MAX_COMPRESSED_ENTRY_BYTES=67108864
ZOHO_V2_BULK_MAX_UNCOMPRESSED_BYTES=536870912
ZOHO_V2_BULK_MAX_CSV_LINE_BYTES=4096
ZOHO_V2_REQUESTS_PER_MINUTE=90
ZOHO_V2_MAX_CONCURRENT_REQUESTS=2
ZOHO_V2_THROTTLE_ACQUIRE_TIMEOUT_MS=5000
ZOHO_V2_THROTTLE_POLL_MS=100
ZOHO_V2_THROTTLE_LOCK_TTL_SECONDS=120
ZOHO_V2_RETRY_MAX_ATTEMPTS=5
ZOHO_V2_RETRY_BATCH_SIZE=100
ZOHO_V2_RETRY_WINDOW_HOURS=12
ZOHO_V2_HOURLY_WARNING_MINUTES=90
ZOHO_V2_HOURLY_CRITICAL_MINUTES=180
ZOHO_V2_NIGHTLY_WARNING_HOURS=30
ZOHO_V2_NIGHTLY_CRITICAL_HOURS=48
ZOHO_V2_MARKETING_CACHE_SECONDS=60

ZOHO_CAMPAIGNS_DRIVER=local
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=
# ZOHO_CAMPAIGNS_TOPIC_ID is REQUIRED when ZOHO_CAMPAIGNS_DRIVER=zoho — Zoho
# createCampaign returns 903 "Mandatory Fields are not found" without it.
# It also now drives per-contact topic subscription: Zoho only delivers a
# campaign to contacts subscribed to its topic ("rubrique"), so when this is
# set, ZohoCampaignsClient::addListSubscribers subscribes each contact via
# POST /json/listsubscribe (with topic_id) instead of the topic-less bulk
# /addlistsubscribersinbulk endpoint.
ZOHO_CAMPAIGNS_TOPIC_ID=
ZOHO_CAMPAIGNS_LIST_KEY=
# Safety gate — keep true until a live Zoho test campaign empirically proves Zoho
# injects its own managed unsubscribe footer (see ZohoCampaignsDriver::prepareHtmlContent()).
# When true (default), the driver appends its own "Se désabonner" footer whenever no
# unsubscribe link is present in the composed HTML.
ZOHO_APPEND_UNSUBSCRIBE_FALLBACK=true

# ---------------------------------------------------------------------------
# Discovery APIs
# ---------------------------------------------------------------------------
SERPAPI_API_KEY=
HUNTER_API_KEY=
HUNTER_API_BASE_URL=https://api.hunter.io/v2
HUNTER_TIMEOUT=20
HUNTER_DISCOVER_TIMEOUT=20

# ---------------------------------------------------------------------------
# AI — lead scoring + template translation (Google Gemini)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Prospecting delivery
# ---------------------------------------------------------------------------
# Keep false locally and in staging. Enable only after legal/compliance approval.
PROSPECTING_COLD_SEND_ENABLED=false
# Direct campaign SMTP mode: use "mailpit" locally (no external delivery)
# and "sender_identity" in production (uses the selected sender's SMTP settings).
PROSPECTING_SMTP_MODE=mailpit
DISCOVERY_DRIVER=local
